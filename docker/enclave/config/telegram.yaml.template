# Telegram bridge configuration for Enclave
# Connects to Synapse via VSOCK proxy

homeserver:
    address: http://127.0.0.1:${VSOCK_SYNAPSE_PORT}
    domain: ${MATRIX_DOMAIN}

appservice:
    address: http://127.0.0.1:29317
    hostname: 127.0.0.1
    port: 29317
    id: telegram
    bot:
        username: telegrambot
        displayname: Telegram Bridge
    ephemeral_events: true

database:
    type: postgres
    uri: postgres://telegram_user:telegram_password@localhost:5432/telegram_db?sslmode=disable

telegram:
    api_id: ${TELEGRAM_API_ID}
    api_hash: ${TELEGRAM_API_HASH}
    bot_token: disabled
    catch_up: true
    sequential_updates: true
    exit_on_update_error: false
    force_refresh_interval_seconds: 0

    connection:
        timeout: 120
        retries: 5
        retry_delay: 1
        flood_sleep_threshold: 60
        request_retries: 5
        use_ipv6: false

    device_info:
        device_model: lightfriend-enclave
        system_version: auto
        app_version: auto
        lang_code: en
        system_lang_code: en

    server:
        enabled: false
        dc: 2
        ip: 149.154.167.40
        port: 80

    proxy:
        type: ${TELEGRAM_PROXY_TYPE:-disabled}
        address: ${TELEGRAM_PROXY_ADDRESS:-}
        port: ${TELEGRAM_PROXY_PORT:-10000}
        rdns: true
        username: ${TELEGRAM_PROXY_USERNAME:-}
        password: ${TELEGRAM_PROXY_PASSWORD:-}

bridge:
    username_template: telegram_{{.}}
    displayname_template: "{{.DisplayName}} (TG)"
    permissions:
        "*": user
        "${MATRIX_DOMAIN}": user

encryption:
    allow: true
    default: true
    appservice: false
    require: false
    allow_key_sharing: true
    verification_levels:
        receive: unverified
        send: unverified
        share: cross-signed-tofu

double_puppet:
    servers:
        ${MATRIX_DOMAIN}: "${DOUBLE_PUPPET_SECRET}"
    secrets:
        ${MATRIX_DOMAIN}: as_token:${DOUBLE_PUPPET_SECRET}

logging:
    min_level: info
    writers:
    - type: stdout
      format: pretty-colored
