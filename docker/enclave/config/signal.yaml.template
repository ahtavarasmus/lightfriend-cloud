# Signal bridge configuration for Enclave (v2 native, no signald)
# Connects to Synapse via VSOCK proxy

homeserver:
    address: http://127.0.0.1:${VSOCK_SYNAPSE_PORT}
    domain: ${MATRIX_DOMAIN}

appservice:
    address: http://127.0.0.1:29328
    hostname: 127.0.0.1
    port: 29328
    id: signal
    bot:
        username: signalbot
        displayname: Signal Bridge
    ephemeral_events: true

database:
    type: postgres
    uri: postgres://signal_user:signal_password@localhost:5432/signal_db?sslmode=disable

bridge:
    username_template: signal_{{.}}
    displayname_template: "{{or .ProfileName .PhoneNumber \"Unknown\"}} (Signal)"
    permissions:
        "*": user
        "${MATRIX_DOMAIN}": user

encryption:
    allow: true
    default: true
    appservice: false
    require: false
    allow_key_sharing: true
    verification_levels:
        receive: unverified
        send: unverified
        share: cross-signed-tofu

double_puppet:
    servers:
        ${MATRIX_DOMAIN}: "${DOUBLE_PUPPET_SECRET}"
    secrets:
        ${MATRIX_DOMAIN}: as_token:${DOUBLE_PUPPET_SECRET}

logging:
    min_level: info
    writers:
    - type: stdout
      format: pretty-colored
